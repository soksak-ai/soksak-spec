{
  "name": "@soksak/soksak-spec",
  "version": "0.0.46",
  "publishConfig": { "access": "public" },
  "description": "Public Soksak plugin, component release, conformance, and authenticated registry contracts.",
  "license": "MIT",
  "author": "soksak-ai",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-ai/soksak-spec.git",
    "directory": "packages/plugin-spec"
  },
  "exports": {
    ".": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    },
    "./registry-publication": {
      "types": "./dist/registryPublication.d.ts",
      "default": "./dist/registryPublication.js"
    }
  },
  "bin": {
    "soksak-validate": "bin/validate.mjs",
    "soksak-local-release": "release-template/local-release.mjs"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "LICENSE",
    "README.md",
    "release-template",
    "spec.json",
    "schema",
    "test/fixtures/platform-wire"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
