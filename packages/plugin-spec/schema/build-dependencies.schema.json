{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soksak:spec:build-dependencies:1",
  "title": "Soksak external build dependencies",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dependencies"],
  "properties": {
    "schema": { "const": "soksak-build-dependencies-v1" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependency" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "repository": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._-]+){2,}\\.git$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "target": { "type": "string", "pattern": "^(aarch64|x86_64)-(apple-darwin|pc-windows-msvc|unknown-linux-(gnu|musl))$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/version" }
    },
    "targetOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": {
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/target" },
      "additionalProperties": { "$ref": "#/$defs/targetOutput" }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "commit", "tools", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "$ref": "#/$defs/repository" },
        "commit": { "$ref": "#/$defs/commit" },
        "tools": { "$ref": "#/$defs/tools" },
        "targets": { "$ref": "#/$defs/targets" }
      }
    }
  }
}
