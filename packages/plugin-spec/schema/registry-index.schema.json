{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soksak:spec:registry:0.0.1",
  "title": "soksak signed plugin registry 0.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "id", "sequence", "plugins", "sidecars", "kits", "profiles", "issuedAt", "expiresAt", "algorithm", "keyId", "signature"],
  "properties": {
    "spec": { "const": "soksak-spec-registry@0.0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "plugins": { "type": "array", "uniqueItems": true, "items": { "allOf": [{ "$ref": "urn:soksak:spec:release:0.0.1" }, { "type": "object", "properties": { "plugin": true }, "required": ["plugin"] }] } },
    "sidecars": { "type": "array", "uniqueItems": true, "items": { "allOf": [{ "$ref": "urn:soksak:spec:release:0.0.1" }, { "type": "object", "properties": { "sidecar": true }, "required": ["sidecar"] }] } },
    "kits": { "type": "array", "uniqueItems": true, "items": { "allOf": [{ "$ref": "urn:soksak:spec:release:0.0.1" }, { "type": "object", "properties": { "kit": true }, "required": ["kit"] }] } },
    "profiles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/profile" } },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "algorithm": { "const": "ed25519" },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "signature": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$" }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "reference": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" }, "version": { "const": "0.0.1" } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["id", "plugin", "bindings"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "plugin": { "$ref": "#/$defs/reference" }, "bindings": { "type": "array" } } }
  }
}
