{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soksak:spec:registry:0.0.1",
  "title": "Authenticated Soksak plugin registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sequence", "issuedAt", "expiresAt", "plugins", "signature"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "plugins": { "type": "array", "items": { "$ref": "urn:soksak:spec:release:0.0.1#/$defs/reference" } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "value"], "properties": { "algorithm": { "const": "ed25519" }, "keyId": { "type": "string" }, "value": { "type": "string" } } }
  }
}
