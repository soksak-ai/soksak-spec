{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soksak:spec:build-dependency-receipt:1",
  "title": "Soksak external build dependency receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dependency", "target", "repository", "commit", "tools", "outputs"],
  "properties": {
    "schema": { "const": "soksak-build-dependency-receipt-v1" },
    "dependency": { "$ref": "#/$defs/id" },
    "target": { "$ref": "#/$defs/target" },
    "repository": { "$ref": "#/$defs/repository" },
    "commit": { "$ref": "#/$defs/commit" },
    "tools": { "$ref": "#/$defs/tools" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "repository": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._-]+){2,}\\.git$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "target": { "type": "string", "pattern": "^(aarch64|x86_64)-(apple-darwin|pc-windows-msvc|unknown-linux-(gnu|musl))$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/version" }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
